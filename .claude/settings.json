{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./go graphify-seed --quiet 2>/dev/null || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./go graphify-status --brief 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
