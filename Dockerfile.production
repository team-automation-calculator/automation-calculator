FROM ruby:3.4.12-slim-trixie

#Install dependencies as root
RUN apt-get update
RUN apt-get install -y build-essential patch zlib1g-dev liblzma-dev libpq-dev curl

#Copy folder over
COPY . /usr/src/app
WORKDIR /usr/src/app

#Install Node.js (ExecJS runtime for CoffeeScript and uglifier)
RUN curl -sL https://deb.nodesource.com/setup_26.x | bash -
RUN apt-get install -y nodejs

#Setup user
RUN useradd -ms /bin/bash automation-calculator-production
RUN usermod -a -G staff automation-calculator-production
RUN chown -R automation-calculator-production /usr/src/app
USER automation-calculator-production

#Install rails dependencies as non root user
RUN gem install nokogiri -v 1.19.4
RUN gem install bundler -v 2.6.9

#Calling bundle install in image creation to install dependencies,
# and also so that important bundle installed bins are in /usr/local/bundle/bin and thus in PATH variable for users.
RUN bundle install --frozen

#Precompile static assets with the production asset pipeline config (digests,
# Uglifier minification) so production serves them straight from public/assets;
# production.rb sets config.assets.compile = false, so nothing compiles at runtime.
# Without RAILS_ENV=production this would run as development (unminified bundles).
# Build-time-only dummy values are set inline so they are not persisted in the image:
# - SECRET_KEY_BASE: Devise needs one at boot (https://github.com/heartcombo/devise/issues/4879).
#   The real value is set per environment at runtime.
# - DATABASE_URL: points at an unreachable host; precompile never connects to the DB.
# The sprockets cache is removed afterwards: it is not needed at runtime once compile is off.
RUN RAILS_ENV=production \
    SECRET_KEY_BASE=dummy-build-time-only \
    DATABASE_URL=postgresql://build@127.0.0.1:1/no-db-at-build-time \
    bundle exec rails assets:precompile \
    && rm -rf tmp/cache/assets

#Default for runs outside Helm (docker-compose.production_http.yml); the
# core-iac Helm chart overrides it per environment from the ingress host
ENV APP_HOSTNAME="automation-calculations.io"

ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.revision=$GIT_COMMIT

ENTRYPOINT [ "/usr/src/app/entrypoint.sh" ]

CMD [ "rails", "s" ]
