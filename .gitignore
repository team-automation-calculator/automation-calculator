# Vim files
*.swp
*.swo

# Environment files hold secrets: never commit one (twelve-factor rule in
# repo-standards). Config comes from the environment through AppConfig
# (lib/app_config.rb). A .env.example with placeholder values may be committed.
.env
.env.*
!.env.example

## Specific to RubyMotion:
.dat*
.repl_history
build/
*.bridgesupport
build-iPhoneOS/
build-iPhoneSimulator/

## Specific to RubyMotion (use of CocoaPods):
