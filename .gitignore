config/settings/*.local.yml
config/environments/*.local.yml

.byebug_history

.sass-cache
*~
/public/assets/
/node_modules/

# Untracked docker compose override, see docker-compose.local.example.yml
docker-compose.local.yml

# Claude Code worktrees live inside the repo, never as siblings in ~/git
/.claude/worktrees/

